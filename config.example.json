{
  "$schema": "./config.schema.json",
  "paths": {
    "checkout": "~/workspace/mexxi",
    "worktreeRoot": "~/.local/share/mexxi/worktrees"
  },
  "hosts": {
    "opencode": true,
    "claude": true,
    "codex": true
  },
  "models": {
    "opencode": {
      "general": null,
      "explore": null,
      "uiDesigner": null,
      "reviewer": null,
      "crossFamilyReviewer": null
    },
    "claude": {
      "uiDesigner": null,
      "reviewer": null,
      "crossFamilyReviewer": null
    },
    "codex": {
      "uiDesigner": null,
      "reviewer": null,
      "crossFamilyReviewer": null
    }
  },
  "workflow": {
    "branchPrefix": "agent/",
    "viewports": [
      1440,
      768,
      390
    ],
    "ports": {
      "first": 4300,
      "last": 4999
    }
  },
  "review": {
    "tool": "ocr"
  },
  "browser": {
    "playwrightMcpVersion": "0.0.83",
    "executablePath": null,
    "outputDir": null
  },
  "guard": {
    "deny": [
      "npm publish",
      "gh pr merge",
      "gh release create",
      "git push --force",
      "git push -f"
    ],
    "protectedBranches": [],
    "blockUnquotedGlobs": false,
    "repeatedFailureLimit": 3
  },
  "claude": {
    "bashMaxTimeoutMs": 900000,
    "contextNudgePercent": 70
  },
  "forge": {
    "hosts": {}
  },
  "jev": {
    "enabled": false,
    "stage": "shadow",
    "model": "typesafe/jev-1.14",
    "endpoint": "https://openrouter.ai/api/alpha/decisions",
    "owners": [],
    "repositories": [],
    "maxPayloadBytes": 32768,
    "timeoutMs": 5000,
    "zeroDataRetention": true
  },
  "retro": {
    "output": "retro/",
    "transcriptRetentionDays": 90
  },
  "mods": [
    "run-pane",
    "command-fixer"
  ]
}
