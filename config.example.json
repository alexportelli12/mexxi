{
  "$schema": "./config.schema.json",
  "paths": {
    "checkout": "~/workspace/mexxi",
    "worktreeRoot": "~/.local/share/mexxi/worktrees"
  },
  "hosts": {
    "opencode": true,
    "claude": true,
    "codex": true
  },
  "models": {
    "opencode": {
      "general": null,
      "explore": null,
      "uiDesigner": null,
      "reviewer": null
    },
    "claude": {
      "uiDesigner": null,
      "reviewer": null
    },
    "codex": {
      "uiDesigner": null,
      "reviewer": null
    }
  },
  "workflow": {
    "branchPrefix": "agent/",
    "viewports": [
      1440,
      768,
      390
    ],
    "ports": {
      "first": 4300,
      "last": 4999,
      "blockSize": 10
    },
    "warmCaches": true,
    "pruneAfterDays": 14,
    "verifySlots": 2,
    "scope": {
      "enabled": true,
      "cpuWeight": 50,
      "memoryMax": "50%"
    },
    "portVariables": {}
  },
  "review": {
    "tool": "ocr"
  },
  "browser": {
    "playwrightMcpVersion": "0.0.83",
    "executablePath": null,
    "outputDir": null
  },
  "guard": {
    "deny": [
      "npm publish",
      "gh pr merge",
      "gh release create",
      "git push --force",
      "git push -f"
    ],
    "protectedBranches": [],
    "repeatedFailureLimit": 3
  },
  "claude": {
    "bashMaxTimeoutMs": 900000,
    "contextNudgePercent": 70
  },
  "forge": {
    "hosts": {}
  },
  "segwi": {
    "enabled": false,
    "bind": {
      "host": "127.0.0.1",
      "port": 4280
    },
    "runner": "claude-code",
    "model": "",
    "repositories": [],
    "extensions": [],
    "auth": {
      "web": {
        "mode": "localhost-only",
        "header": "Tailscale-User-Login",
        "allowed": [],
        "hostname": ""
      }
    },
    "limits": {
      "concurrentRuns": 2,
      "runsPerDay": 20,
      "maxTurns": 80,
      "idleTimeoutMinutes": 30,
      "hardTimeoutMinutes": 120,
      "approvalTimeoutMinutes": 60,
      "taskMaxChars": 8000,
      "inputMaxChars": 4000
    },
    "canary": {
      "model": "haiku",
      "maxTurns": 6
    },
    "push": true,
    "vapidSubject": "",
    "service": {
      "systemdUserUnit": false
    }
  },
  "retro": {
    "output": "retro/",
    "transcriptRetentionDays": 90
  },
  "mods": [
    "run-pane"
  ]
}
