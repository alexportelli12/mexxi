{
  "description": "Secret patterns redacted before text leaves this machine (Jev triage) or lands in a report (retro). One source for both: JavaScript compiles each as new RegExp(pattern, \"g\" + flags), Python as re.compile(pattern) with the same i, m and s flags. Patterns use only syntax both engines read the same way; one that spans lines uses [\\s\\S], which needs no flag in either, and lookbehind stays fixed-width, as Python requires. URL credentials keep the scheme and host, so only the user and password are replaced. Patterns run in this order, so a block (a PEM key) comes before the patterns that would match pieces of it.",
  "replacement": "[REDACTED]",
  "patterns": [
    { "name": "PEM private key", "pattern": "-----BEGIN [A-Z ]*PRIVATE KEY-----[\\s\\S]*?-----END [A-Z ]*PRIVATE KEY-----", "flags": "" },
    { "name": "openai-style key", "pattern": "sk-[A-Za-z0-9_-]{16,}", "flags": "" },
    { "name": "GitHub token", "pattern": "gh[pousr]_[A-Za-z0-9]{20,}", "flags": "" },
    { "name": "GitHub fine-grained token", "pattern": "github_pat_[A-Za-z0-9_]{20,}", "flags": "" },
    { "name": "AWS access key", "pattern": "AKIA[0-9A-Z]{16}", "flags": "" },
    { "name": "Google API key", "pattern": "AIza[0-9A-Za-z_-]{35}", "flags": "" },
    { "name": "Slack token", "pattern": "xox[abpors]-[A-Za-z0-9-]{10,}", "flags": "" },
    { "name": "Shopify token", "pattern": "shp(at|ss|ca|pa)_[A-Fa-f0-9]{16,}", "flags": "" },
    { "name": "JWT", "pattern": "eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{5,}", "flags": "" },
    { "name": "Stripe key", "pattern": "\\b[rs]k_(?:live|test)_[A-Za-z0-9]{10,}", "flags": "" },
    { "name": "GitLab token", "pattern": "glpat-[A-Za-z0-9_-]{20,}", "flags": "" },
    { "name": "bearer credential", "pattern": "bearer\\s+[A-Za-z0-9._~+/=-]{12,}", "flags": "i" },
    { "name": "basic auth header", "pattern": "\\bauthorization\\s*[:=]\\s*basic\\s+[A-Za-z0-9+/=]+", "flags": "i" },
    { "name": "URL credentials", "pattern": "(?<=://)[^\\s/:@]+:[^\\s/]*(?=@)", "flags": "" },
    { "name": "quoted secret-named field", "pattern": "([\"'])[A-Za-z0-9_.-]*(?:key|token|secret|password|passwd|pwd|auth|credential)s?\\1\\s*:\\s*([\"'])(?:\\\\.|(?!\\2)[^\\\\\\n])*\\2", "flags": "i" },
    { "name": "secret-named assignment", "pattern": "\\b([A-Z0-9_]*(?:key|token|secret|password|passwd|pwd)[A-Z0-9_]*)\\s*[=:]\\s*\\S+", "flags": "i" },
    { "name": "long opaque token", "pattern": "\\b(?=[A-Za-z0-9_-]*\\d)(?=[A-Za-z0-9_-]*[A-Za-z])[A-Za-z0-9_-]{40,}\\b", "flags": "" }
  ]
