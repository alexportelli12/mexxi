{
  "$schema": "./node_modules/verifika/schemas/verifika.schema.json",
  "version": 1,
  "changes": {
    "invalidateAll": ["package.json", "package-lock.json"]
  },
  "checks": {
    "config": { "command": "node scripts/check-config.mjs" },
    "settings": {
      "command": "node --test scripts/config.test.mjs",
      "paths": ["scripts/config.test.mjs", "scripts/lib/config.mjs", "config.schema.json"]
    },
    "workspace": {
      "command": "node --test scripts/implementation-workspace.test.mjs",
      "paths": ["scripts/implementation-workspace*", "scripts/lib/config.mjs", "config.schema.json"]
    },
    "repo-context": {
      "command": "node --test skills/repo-context/tests/inspect.test.js",
      "paths": ["skills/repo-context/**"]
    },
    "integration": {
      "command": "node --test scripts/integration.test.mjs",
      "dependsOn": ["config"]
    }
  }
}
